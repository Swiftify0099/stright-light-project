/**
 * @file GwSecrets.h.example
 * @brief Example template for local Gateway credentials.
 * 
 * Copy this file to GwSecrets.h and fill in real local credentials.
 * GwSecrets.h is excluded from git tracking via .gitignore.
 */

#ifndef GW_SECRETS_H
#define GW_SECRETS_H

// Local Wi-Fi Credentials
#define MSCB_WIFI_SSID              "YOUR_WIFI_SSID"
#define MSCB_WIFI_PASS              "YOUR_WIFI_PASSWORD"

// Telegram Bot Credentials
#define MSCB_TELEGRAM_BOT_TOKEN     "0000000000:AAExampleTelegramTokenPlaceholder"
#define MSCB_TELEGRAM_CHAT_ID       "123456789" // Primary Admin Chat ID

// Telegram Admin Allowlist (Comma separated list of authorized numeric Chat IDs)
#define MSCB_TELEGRAM_ADMIN_ALLOWLIST { 123456789LL }
#define MSCB_TELEGRAM_ADMIN_COUNT     1

// Provisioned Network Cryptographic Key (32-byte hexadecimal string / array)
#define MSCB_PROVISIONED_AES_KEY { \
  0x10, 0x21, 0x32, 0x43, 0x54, 0x65, 0x76, 0x87, \
  0x98, 0xA9, 0xBA, 0xCB, 0xDC, 0xED, 0xFE, 0x0F, \
  0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, \
  0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF, 0x00  \
}
#define MSCB_PROVISIONED_KEY_EPOCH 1

#endif // GW_SECRETS_H
